# Copie este arquivo com o nome ".env" (na mesma pasta) e preencha.
# NUNCA mande o .env para ninguém nem poste em lugar nenhum: ele tem a sua chave.

# Seu usuário do TikTok, sem o @
TIKTOK_USUARIO=seu_usuario_aqui

# Sua chave da Euler Stream (https://www.eulerstream.com)
EULER_API_KEY=cole_sua_chave_aqui

# Porta do jogo no seu PC (o link fica http://localhost:8080)
PORTA=8080
